alert modbus any any -> any any (msg:"ICS LAB Modbus holding register write detected"; flow:to_server; modbus: access write holding; classtype:protocol-command-decode; sid:1000001; rev:1;)

alert modbus any any -> any any (msg:"ICS LAB Abnormally low temperature setpoint"; flow:to_server; modbus: access write holding, address 1, value 0<>50; classtype:protocol-command-decode; sid:1000002; rev:2;)
